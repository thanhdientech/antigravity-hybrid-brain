{
  "manifest_version": 3,
  "name": "Antigravity Omni-Browser Controller",
  "version": "1.1.0",
  "description": "Điều khiển trình duyệt toàn năng cho Antigravity AI Agent: Điều hướng, Click, Gõ phím, Đọc DOM, Upload file, Chạy script, Debug Console, Tải file.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "webNavigation",
    "downloads",
    "debugger",
    "alarms",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Antigravity Browser Controller",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
